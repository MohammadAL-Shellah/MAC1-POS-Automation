GEMINI_API_KEY=replace_with_your_rotated_key
GEMINI_MODEL=gemini-flash-lite-latest
# Optional override; defaults to the portal executable path shared in the setup.
# PORTAL_EXE_PATH=C:\path\to\Minerets.Shop.MacOne.exe
# Optional, only for a future build with WebView2 debugging. Leave unset for the native MacOne app (UI Automation is used).
# PORTAL_CDP_URL=http://127.0.0.1:9222
