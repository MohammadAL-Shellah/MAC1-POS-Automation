    {
      "source": "claude",
      "type": "question",
      "storyId": 214,
      "title": "After Close Day, should the Current Cash Register block still show the closed register, or show no active register until Open Day?",
      "notes": "Seen 20/11 after closing TO_11000031",
      "devopsId": null,
      "owner": "Mohammad Alshellah",
      "timestamp": "2026-11-20T22:48:30+03:00",
      "url": null,
      "status": "answered",
      "question": {
        "answer": "Depends on a setting: the register block follows the shift end time; after midnight the data resets because it is a new day (user 23/11).",
        "answeredOn": "2026-11-23"
